# Copy to .env for local development.

# Postgres connection string (Neon, Supabase, or a local server).
DATABASE_URL=postgresql://masarif:masarif@localhost:5432/masarif

# Random string of at least 16 characters used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
PORT=3000
# RUN_MIGRATIONS=false   # skip applying migrations on startup
